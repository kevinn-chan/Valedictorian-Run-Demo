# Copy this file to .env.local and replace every placeholder there — see SETUP.md.
# Never put real values in this file: it is committed. .env.local is gitignored.

# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only; never expose to the client

# Auth allowlist (comma-separated). Must match the allowed_emails table (SETUP.md 1c).
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Profiles shown on the login screen ("Name:email,Name:email"). Each person gets
# a magic link at that email. Emails listed here are allowed automatically.
PROFILES=You:you@example.com,Teammate:teammate@example.com

# LLM — Gemini free tier is primary; OpenAI Tier 3 is break-glass only
LLM_PROVIDER=google                    # google | openai (flip = full failover)
GOOGLE_GENERATIVE_AI_API_KEY=          # aistudio.google.com → Get API key
OPENAI_API_KEY=                        # break-glass account only

# Optional: require this bearer token on /api/keepalive (Vercel sends it automatically).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional public read-only demo at /demo. Point at a compiled session that's
# safe to show the world: its wiki, cards, figures and source pages become public.
# Find the id with: select id, title from public.sessions;  Unset = /demo is off.
DEMO_SESSION_ID=
# Optional: a separate Gemini key for the demo so public traffic can't starve
# the real app's quota. Falls back to GOOGLE_GENERATIVE_AI_API_KEY if unset.
DEMO_GEMINI_KEY=
